    // Logout functionality
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      const shouldLogout = await showDialog({
        title: 'Sign Out',
        message: 'Are you sure you want to logout from FlowTrace Recorder?',
        confirmText: 'Logout',
        cancelText: 'Cancel',
        type: 'info'
      });

      if (!shouldLogout) return;

      localStorage.removeItem('authToken');
      localStorage.removeItem('refreshToken');
      localStorage.removeItem('user');
      window.location.href = '/login';
    });

    // Window chrome actions
    document.getElementById('navBack').addEventListener('click', () => {
      window.history.back();
    });

    document.getElementById('navRefresh').addEventListener('click', () => {
      hydrateContext();
      setStatus('Context refreshed');
