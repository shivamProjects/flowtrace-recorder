    function syncRecordModeOptionState() {
      elements.recordModeOptions.forEach((option) => {
        const modeInput = option.querySelector('input[type="radio"]');
        option.classList.toggle('is-selected', Boolean(modeInput && modeInput.checked));
      });
    }

    elements.recordModeOptions.forEach((option) => {
      option.addEventListener('click', () => {
        const modeInput = option.querySelector('input[type="radio"]');
        if (!modeInput) return;
        modeInput.checked = true;
        syncRecordModeOptionState();
      });
    });

    elements.manualModeRadio.addEventListener('change', syncRecordModeOptionState);
    elements.instantModeRadio.addEventListener('change', syncRecordModeOptionState);

    // Show recording mode modal
    elements.startRecord.addEventListener('click', () => {
      elements.manualModeRadio.checked = true;
      syncRecordModeOptionState();
      elements.recordModeOverlay.classList.add('is-open');
      document.body.classList.add('dialog-open');
      renderLucideIcons();
    });

    // Close recording mode modal
    function closeRecordModeModal() {
      elements.recordModeOverlay.classList.remove('is-open');
      document.body.classList.remove('dialog-open');
    }

    elements.recordModeClose.addEventListener('click', closeRecordModeModal);
    elements.recordModeCancel.addEventListener('click', closeRecordModeModal);

    elements.recordModeOverlay.addEventListener('click', (event) => {
      if (event.target === elements.recordModeOverlay) {
        closeRecordModeModal();
      }
    });

    // Start recording based on selected mode
    elements.recordModeConfirm.addEventListener('click', async () => {
      const isManualMode = elements.manualModeRadio.checked;
      const url = elements.recordUrl.value.trim();

      // Validate URL for Record Navigation Path mode
      if (!isManualMode && !url) {
        showToast('Please enter a URL for Record Navigation Path mode.', 'warning');
        return;
      }

      closeRecordModeModal();

      await withButtonLoading(elements.startRecord, 'Starting...', async () => {
        try {
          setStatus('Starting recording...');

          const response = await fetch('/api/record/start', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              url: url || '',
              mode: isManualMode ? 'manual' : 'instant'
            })
          });

          const data = await response.json();

          if (data.success) {
            isRecording = true;
            elements.startRecord.disabled = true;
            elements.stopRecord.disabled = false;
            elements.recordUrl.disabled = true;
            setStatus('Recording started');

            const modeMessage = isManualMode
              ? 'Browser opened. Navigate manually to your desired page and perform your actions. Close the browser when finished.'
              : 'Browser will navigate to the URL. Perform your actions, then close the browser when done.';

            await showDialog({
              title: 'Recording Started',
              message: data.message || modeMessage,
              confirmText: 'Ok',
              cancelText: '',
              type: 'success'
            });
          } else {
            elements.startRecord.disabled = false;
            setStatus('Start failed');
            showToast(data.error || 'Failed to start recording.', 'error');
          }
        } catch (error) {
          elements.startRecord.disabled = false;
          setStatus('Start failed');
          showToast(error.message || 'Failed to start recording.', 'error');
        }
      });
    });

    // Stop recording
    elements.stopRecord.addEventListener('click', async () => {
      await withButtonLoading(elements.stopRecord, 'Stopping...', async () => {
        try {
          setStatus('Stopping recording...');

          const response = await fetch('/api/record/stop', {
            method: 'POST'
          });

          const data = await response.json();

          if (data.success) {
            isRecording = false;
            currentActions = data.actions || [];
            elements.startRecord.disabled = false;
            elements.stopRecord.disabled = true;
            elements.recordUrl.disabled = false;
            displayActions(currentActions);
            setStatus(`Stopped - ${data.count} actions`);
            showToast(`Recording stopped. ${data.count} actions captured.`, 'success');
            await openSavePanelForCurrentRecording();
          } else {
            elements.stopRecord.disabled = false;
            setStatus('Stop failed');
            showToast(data.error || 'Failed to stop recording.', 'error');
          }
        } catch (error) {
          elements.stopRecord.disabled = false;
          setStatus('Stop failed');
          showToast(error.message || 'Failed to stop recording.', 'error');
        }
      });
    });

    elements.discardRecording.addEventListener('click', () => {
      discardCurrentRecording();
    });

    elements.confirmSave.addEventListener('click', async () => {
      const testCaseName = elements.testCaseName.value.trim();
      const description = elements.description.value.trim();
      const token = localStorage.getItem('authToken');

      if (!selectedBusinessProcessOption) {
        showToast('Please select a business process before saving.', 'warning');
        return;
      }

      if (!testCaseName) {
        showToast('Please enter a test case name before saving.', 'warning');
        return;
      }

      if (!description) {
        showToast('Please enter description before saving.', 'warning');
        return;
      }

      if (!selectedCustomerOption) {
        showToast('Please select a customer before saving.', 'warning');
        return;
      }

      if (!selectedInstanceOption) {
        showToast('Please select an instance before saving.', 'warning');
        return;
      }

      if (!selectedInstanceUserOption) {
        showToast('Please select an instance user before saving.', 'warning');
        return;
      }

      if (requiredTestCasePrefix) {
        const normalizedName = testCaseName.toUpperCase();
        const normalizedPrefix = requiredTestCasePrefix.toUpperCase();
        if (!normalizedName.startsWith(normalizedPrefix) || testCaseName.length <= requiredTestCasePrefix.length) {
          showToast(`Test Case Name must start with ${requiredTestCasePrefix} and include additional text.`, 'warning');
          return;
        }
      }

      if (!token) {
        await showDialog({
          title: 'Session Expired',
          message: 'Authentication token not found. Please login again.',
          confirmText: 'Go to Login',
          cancelText: '',
          type: 'warning'
        });
        window.location.href = '/login';
        return;
      }

      elements.discardRecording.disabled = true;
      try {
        await withButtonLoading(elements.confirmSave, 'Saving...', async () => {
          try {
            setStatus('Saving recording...');

            // Remove timestamps from steps
            const stepsWithoutTimestamp = currentActions.map((action) => {
              const { timestamp, ...rest } = action;
              return rest;
            });

            const titleTimestamp = formatTitleTimestamp(new Date());
            const finalTitle = `${testCaseName}.${titleTimestamp}`;

            // Prepare API payload
            const apiPayload = {
              title: finalTitle,
              description,
              status: 'draft',
              customer_id: toTypedId(selectedCustomerOption.id),
              instance_id: toTypedId(selectedInstanceOption.id),
              instance_user_id: toTypedId(selectedInstanceUserOption.id),
              metadata: {
                createdFrom: 'chrome_extension',
                userEnteredName: testCaseName,
                generatedAt: new Date().toISOString()
              },
              steps: stepsWithoutTimestamp
            };

            // Step 1 � Create recording + script
            const response = await fetch('/api/proxy/api/extension/recordings', {
              method: 'POST',
              headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(apiPayload)
            });

            checkAuthResponse(response);

            const data = await response.json();

            if (response.ok && data.success) {
              // Step 2 � Assign business process to the created script (sets mp_id)
              if (selectedBusinessProcessOption && data.script_id) {
                try {
                  const scriptCode = finalTitle.toUpperCase().replace(/[^A-Z0-9]+/g, '_').replace(/^_+|_+$/g, '').substring(0, 120);
                  const bpResponse = await fetch(`/api/proxy/api/scripts/${data.script_id}/details`, {
                    method: 'PUT',
                    headers: {
                      'Authorization': `Bearer ${token}`,
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                      script_code: scriptCode,
                      script_name: finalTitle,
                      process_name: selectedBusinessProcessOption.value,
                      description: description || finalTitle
                    })
                  });
                  if (bpResponse.ok) {
                    console.log('[recorder] Business process assigned:', selectedBusinessProcessOption.value);
                  } else {
                    const bpErr = await bpResponse.json().catch(() => ({}));
                    console.error('[recorder] Business process assignment failed:', bpErr.message || bpResponse.status);
                  }
                } catch (bpError) {
                  console.error('[recorder] Business process assignment error:', bpError.message);
                }
              }
              showToast(data.message || 'Recording saved successfully.', 'success');
              elements.savePanel.style.display = 'none';
              elements.testCaseName.value = '';
              elements.description.value = '';
              await loadRecentScripts(true);
              setStatus('Recording saved');
              elements.confirmSave.disabled = false;
            } else {
              elements.confirmSave.disabled = false;
              setStatus('Save failed');
              showToast(data.message || data.error || 'Failed to save recording.', 'error');
            }
          } catch (error) {
            elements.confirmSave.disabled = false;
            setStatus('Save failed');
            showToast(error.message || 'Failed to save recording.', 'error');
          }
        });
      } finally {
        elements.discardRecording.disabled = false;
      }
    });

