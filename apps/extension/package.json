{
  "name": "flowtrace-recorder-ext",
  "version": "1.0.0",
  "description": "FlowTrace Recorder — Chrome extension",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-injected.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "pretest": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package": "node scripts/package-zip.mjs"
  },
  "dependencies": {
    "@flowtrace/contracts": "workspace:*",
    "@flowtrace/recorder-core": "workspace:*",
    "@flowtrace/recorder-host": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "playwright-core": "1.62.1",
    "vitest": "^2.1.8"
  }
}
